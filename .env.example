# Copy to .env (cp .env.example .env) and fill in the first four lines. Never commit or share .env.

# --- required ---------------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# 32+ random characters, for example the output of:  openssl rand -hex 32
JWT_SECRET=
# the code people must type to register
INVITE_CODE=
# your domain name without https:// (a free DuckDNS name is fine). For a test on your own computer use: localhost
DOMAIN=

# --- models (defaults shown) --------------------------------------------------------------------
LK_MODEL_FINAL=claude-sonnet-5-5
LK_WHISPER_SIZE=small

# --- limits (defaults shown) --------------------------------------------------------------------
DAILY_LIMIT=5
MAX_RECORDING_MB=1500
MAX_CHUNK_MB=60
MAX_SLIDES_MB=100
KEEP_MEDIA_DAYS=7

# --- who may call the API from a browser (CORS; no "*") -----------------------------------------
# the web app is served from the same domain, so this is only needed if it is hosted elsewhere
WEB_ORIGIN=
# chrome-extension://<the extension id>, filled in once the extension exists
EXTENSION_ORIGIN=

# --- server sizing and build options (defaults shown) --------------------------------------------
# memory cap of the app container: keep it below the server's RAM (for example 3g on a 4 GB server)
# APP_MEM_LIMIT=6g
# 0 leaves LibreOffice out (about 500 MB smaller; the server then asks for slides as PDF); rebuild after changing
# WITH_LIBREOFFICE=1

# --- only for a test on your own computer (the real server uses 80 and 443) -----------------------
# HTTP_PORT=8080
# HTTPS_PORT=8443
