# cp .env.example .env, then fill in the required values. Never commit .env.

# required
ANTHROPIC_API_KEY=
# 32+ random characters: openssl rand -hex 32
JWT_SECRET=
# domain without https:// (localhost for a test on your own computer)
DOMAIN=

# email for the sign-up code (empty SMTP_HOST: the email is written to the server log)
# Gmail: smtp.gmail.com, 587, your address and an App Password. Mailtrap: sandbox.smtp.mailtrap.io, 2525
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# sender shown to people, for example: LectureKit <you@gmail.com> (Mailtrap accepts any address)
SMTP_FROM=
# Google login client ID (empty: off)
GOOGLE_CLIENT_ID=

# models
LK_MODEL_FINAL=claude-sonnet-5-5
LK_WHISPER_SIZE=small

# limits
DAILY_LIMIT=5
MAX_RECORDING_MB=1500
MAX_RECORDING_PARTS=10
MAX_STORAGE_GB=10
VISUALS_ENABLED=1
MAX_CHUNK_MB=60
MAX_SLIDES_MB=100
KEEP_MEDIA_DAYS=7
LOG_RETENTION_DAYS=14

# CORS origins (empty when the web app is on the same domain)
WEB_ORIGIN=
EXTENSION_ORIGIN=

# optional
# APP_MEM_LIMIT=6g
# WITH_LIBREOFFICE=1
# HTTP_PORT=8080
# HTTPS_PORT=8443
