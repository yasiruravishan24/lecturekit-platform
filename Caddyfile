# {$DOMAIN} comes from .env. Caddy gets and renews the HTTPS certificate by itself
# (DOMAIN=localhost gives a local certificate for testing on your own computer).
{$DOMAIN} {
	encode gzip

	# must be larger than MAX_RECORDING_MB in .env (default 1500), a little more for the form data around the file
	request_body {
		max_size 1600MB
	}

	# everything goes to the app: /api/*, /health, and the web app files at / (once there is a web app)
	reverse_proxy app:8000 {
		transport http {
			response_header_timeout 600s
		}
	}
}
