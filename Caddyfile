# {$DOMAIN} comes from .env. Caddy gets and renews the HTTPS certificate by itself
# (DOMAIN=localhost gives a local certificate for testing on your own computer).
{$DOMAIN} {
	encode gzip

	# must be larger than MAX_RECORDING_MB in .env (default 1500)
	request_body {
		max_size 1600MB
	}

	handle /api/* {
		reverse_proxy app:8000
	}
	handle /health {
		reverse_proxy app:8000
	}

	handle {
		# the web app goes here later:   reverse_proxy web:80
		respond "LectureKit API is running. The web app is not installed yet. API docs: /api/docs" 200
	}
}
